{
    "assistant_name": "Victor",
    "operator_name": "Vishnu",
    "language_mode": "auto",
    "power_mode": "low_power",
    "ollama": {
        "host": "http://localhost:11434",
        "chat_endpoint": "/api/chat",
        "tags_endpoint": "/api/tags",
        "model": "qwen3.5:9b",
        "temperature": 0.7,
        "max_context_turns": 15
    },
    "voice": {
        "wake_word": "Victor",
